{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "manifest": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 160,
          "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+){2,}$"
        },
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
        },
        "apiVersion": { "type": "string", "const": "0" },
        "description": { "type": "string", "maxLength": 240 },
        "category": { "type": "string", "minLength": 1, "maxLength": 48 },
        "author": {
          "type": "object",
          "properties": {
            "name": { "type": "string", "minLength": 1, "maxLength": 80 },
            "url": { "type": "string", "format": "uri" }
          },
          "required": ["name"],
          "additionalProperties": false
        },
        "icon": {
          "type": "string",
          "enum": [
            "Activity",
            "AudioLines",
            "AudioWaveform",
            "BookOpenText",
            "Box",
            "CassetteTape",
            "FileMusic",
            "Globe",
            "Grid2x2",
            "Guitar",
            "KeyboardMusic",
            "ListMusic",
            "MicVocal",
            "Music2",
            "NotebookPen",
            "Radio",
            "Repeat2",
            "ScrollText",
            "SlidersHorizontal",
            "Speech",
            "Waves"
          ]
        },
        "tags": {
          "maxItems": 16,
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 32 }
        },
        "capabilities": {
          "maxItems": 16,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "midi.input",
              "midi.output",
              "midi.control-mapping",
              "midi.device-input",
              "midi.device-output",
              "collaboration.shared-state",
              "transport.read",
              "transport.schedule",
              "audio.input",
              "audio.output",
              "audio.decode",
              "mixer.read",
              "mixer.write",
              "song.read",
              "song.perform",
              "song.write",
              "clock.follow",
              "network.fetch",
              "microphone.input",
              "file.import",
              "file.export",
              "asset.read",
              "asset.write"
            ]
          }
        },
        "liveSession": {
          "type": "object",
          "properties": {
            "performance": {
              "maxItems": 3,
              "type": "array",
              "items": {
                "type": "string",
                "enum": ["midi", "transport", "shared-loop"]
              }
            }
          },
          "additionalProperties": false
        },
        "minimumSize": {
          "type": "object",
          "properties": {
            "width": { "type": "integer", "minimum": 120, "maximum": 2048 },
            "height": { "type": "integer", "minimum": 96, "maximum": 2048 }
          },
          "required": ["width", "height"],
          "additionalProperties": false
        },
        "preferredSize": {
          "type": "object",
          "properties": {
            "width": { "type": "integer", "minimum": 120, "maximum": 4096 },
            "height": { "type": "integer", "minimum": 96, "maximum": 4096 }
          },
          "required": ["width", "height"],
          "additionalProperties": false
        }
      },
      "required": ["id", "name", "version", "apiVersion"],
      "additionalProperties": false
    },
    "state": {
      "type": "object",
      "properties": {
        "version": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "fields": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z][A-Za-z0-9-]{0,63}$"
          },
          "additionalProperties": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "type": { "type": "string", "const": "string" },
                  "default": { "type": "string" },
                  "scope": {
                    "type": "string",
                    "enum": [
                      "shared-persisted",
                      "local-persisted",
                      "local-ephemeral"
                    ]
                  },
                  "label": { "type": "string" },
                  "description": { "type": "string" },
                  "liveSessionEditable": { "type": "boolean" },
                  "options": { "type": "array", "items": { "type": "string" } },
                  "maxLength": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "required": ["type", "default", "scope"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": { "type": "string", "const": "number" },
                  "default": { "type": "number" },
                  "scope": {
                    "type": "string",
                    "enum": [
                      "shared-persisted",
                      "local-persisted",
                      "local-ephemeral"
                    ]
                  },
                  "label": { "type": "string" },
                  "description": { "type": "string" },
                  "liveSessionEditable": { "type": "boolean" },
                  "integer": { "type": "boolean" },
                  "minimum": { "type": "number" },
                  "maximum": { "type": "number" },
                  "step": { "type": "number", "exclusiveMinimum": 0 }
                },
                "required": ["type", "default", "scope"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": { "type": "string", "const": "boolean" },
                  "default": { "type": "boolean" },
                  "scope": {
                    "type": "string",
                    "enum": [
                      "shared-persisted",
                      "local-persisted",
                      "local-ephemeral"
                    ]
                  },
                  "label": { "type": "string" },
                  "description": { "type": "string" },
                  "liveSessionEditable": { "type": "boolean" }
                },
                "required": ["type", "default", "scope"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": { "type": "string", "const": "json" },
                  "default": { "$ref": "#/$defs/__schema0" },
                  "scope": {
                    "type": "string",
                    "enum": [
                      "shared-persisted",
                      "local-persisted",
                      "local-ephemeral"
                    ]
                  },
                  "label": { "type": "string" },
                  "description": { "type": "string" },
                  "liveSessionEditable": { "type": "boolean" }
                },
                "required": ["type", "default", "scope"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": { "type": "string", "const": "asset" },
                  "default": {
                    "anyOf": [
                      {
                        "type": "object",
                        "properties": {
                          "id": { "type": "string", "minLength": 1 },
                          "name": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 240
                          },
                          "mimeType": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 120
                          },
                          "byteSize": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991
                          },
                          "createdAt": { "type": "string", "minLength": 1 },
                          "storage": {
                            "type": "object",
                            "propertyNames": { "type": "string" },
                            "additionalProperties": {
                              "$ref": "#/$defs/__schema1"
                            }
                          }
                        },
                        "required": [
                          "id",
                          "name",
                          "mimeType",
                          "byteSize",
                          "createdAt",
                          "storage"
                        ],
                        "additionalProperties": false
                      },
                      { "type": "null" }
                    ]
                  },
                  "scope": {
                    "type": "string",
                    "enum": [
                      "shared-persisted",
                      "local-persisted",
                      "local-ephemeral"
                    ]
                  },
                  "label": { "type": "string" },
                  "description": { "type": "string" },
                  "accept": {
                    "maxItems": 32,
                    "type": "array",
                    "items": { "type": "string", "minLength": 1 }
                  },
                  "maximumBytes": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "required": ["type", "default", "scope"],
                "additionalProperties": false
              }
            ]
          }
        }
      },
      "required": ["version", "fields"],
      "additionalProperties": false
    },
    "ports": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
          "type": {
            "type": "string",
            "enum": ["midi.notes", "midi.messages", "audio"]
          },
          "label": { "type": "string", "minLength": 1, "maxLength": 64 },
          "direction": { "type": "string", "enum": ["in", "out"] }
        },
        "required": ["id", "type", "label", "direction"],
        "additionalProperties": false
      }
    }
  },
  "required": ["manifest", "state"],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "anyOf": [
        { "type": "string" },
        { "type": "number" },
        { "type": "boolean" },
        { "type": "null" },
        { "type": "array", "items": { "$ref": "#/$defs/__schema0" } },
        {
          "type": "object",
          "propertyNames": { "type": "string" },
          "additionalProperties": { "$ref": "#/$defs/__schema0" }
        }
      ]
    },
    "__schema1": {
      "anyOf": [
        { "type": "string" },
        { "type": "number" },
        { "type": "boolean" },
        { "type": "null" },
        { "type": "array", "items": { "$ref": "#/$defs/__schema1" } },
        {
          "type": "object",
          "propertyNames": { "type": "string" },
          "additionalProperties": { "$ref": "#/$defs/__schema1" }
        }
      ]
    }
  }
}
