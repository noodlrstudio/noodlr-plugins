{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 160,
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+){2,}$"
    },
    "name": { "type": "string", "minLength": 1, "maxLength": 80 },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "apiVersion": { "type": "string", "const": "0" },
    "description": { "type": "string", "maxLength": 240 },
    "category": { "type": "string", "minLength": 1, "maxLength": 48 },
    "author": {
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "url": { "type": "string", "format": "uri" }
      },
      "required": ["name"],
      "additionalProperties": false
    },
    "icon": {
      "type": "string",
      "enum": [
        "Activity",
        "AudioLines",
        "AudioWaveform",
        "BookOpenText",
        "Box",
        "CassetteTape",
        "FileMusic",
        "Globe",
        "Grid2x2",
        "Guitar",
        "KeyboardMusic",
        "ListMusic",
        "MicVocal",
        "MonitorPlay",
        "Music2",
        "NotebookPen",
        "Radio",
        "Repeat2",
        "ScrollText",
        "SlidersHorizontal",
        "Speech",
        "Waves"
      ]
    },
    "tags": {
      "maxItems": 16,
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 32 }
    },
    "capabilities": {
      "maxItems": 16,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "midi.input",
          "midi.output",
          "midi.control-mapping",
          "midi.device-input",
          "midi.device-output",
          "collaboration.shared-state",
          "transport.read",
          "transport.schedule",
          "audio.input",
          "audio.output",
          "audio.decode",
          "mixer.read",
          "mixer.write",
          "song.read",
          "song.perform",
          "song.write",
          "clock.follow",
          "network.fetch",
          "microphone.input",
          "file.import",
          "file.export",
          "asset.read",
          "asset.write"
        ]
      }
    },
    "liveSession": {
      "type": "object",
      "properties": {
        "performance": {
          "maxItems": 3,
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["midi", "transport", "shared-loop"]
          }
        }
      },
      "additionalProperties": false
    },
    "minimumSize": {
      "type": "object",
      "properties": {
        "width": { "type": "integer", "minimum": 120, "maximum": 2048 },
        "height": { "type": "integer", "minimum": 96, "maximum": 2048 }
      },
      "required": ["width", "height"],
      "additionalProperties": false
    },
    "preferredSize": {
      "type": "object",
      "properties": {
        "width": { "type": "integer", "minimum": 120, "maximum": 4096 },
        "height": { "type": "integer", "minimum": 96, "maximum": 4096 }
      },
      "required": ["width", "height"],
      "additionalProperties": false
    }
  },
  "required": ["id", "name", "version", "apiVersion"],
  "additionalProperties": false
}
