{
  "name": "@noodlrstudio/plugin-sdk",
  "version": "0.1.0",
  "description": "Browser integration contracts for Noodlr web apps and audio plugins.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./web-app": {
      "types": "./dist/web-app.d.ts",
      "import": "./dist/web-app.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "prepare": "npm run build",
    "prepack": "npm run build && npm test",
    "test": "vitest run"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "vitest": "^4.1.9"
  }
}
