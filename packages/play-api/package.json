{
  "name": "@noodlr/play-api",
  "version": "0.3.0",
  "description": "The Noodlr Play node contract: manifest, capabilities, state fields, host context types, validation and a mock context for tests.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc --project tsconfig.build.json && node scripts/add-js-extensions.mjs dist",
    "prepare": "npm run build",
    "prepack": "npm run build && npm test",
    "generate:schemas": "tsx scripts/generate-json-schemas.ts",
    "generate:theme": "tsx scripts/generate-theme-css.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^4.1.12"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "prettier": "^3.8.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "vitest": "^4.1.9"
  }
}
